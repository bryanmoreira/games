# Postgres (local: o do seu PC; no Easypanel: crie um serviço Postgres e copie a "Internal Connection URL")
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/mesadejogos?schema=public"

# Better Auth
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL pública do site (em produção: https://mesadejogos.com)
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com > APIs e serviços > Credenciais)
# URI de redirecionamento autorizado: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Discord OAuth (discord.com/developers/applications > OAuth2)
# Redirect: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# Assina o login para o servidor de jogos e autentica os resultados que ele manda (mesmo valor no serviço ws)
# Gere com: openssl rand -hex 32
GAME_SECRET=""

# Google AdSense (adsense.google.com). Sem os dois, o site não mostra anúncios.
# ID do editor (Conta > Informações da conta), no formato ca-pub-0000000000000000
ADSENSE_CLIENT=""
# ID de um bloco de anúncios de display responsivo (Anúncios > Por bloco de anúncios)
ADSENSE_SLOT=""

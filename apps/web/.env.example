# Postgres (local: o do seu PC; no Easypanel: crie um serviço Postgres e copie a "Internal Connection URL")
DATABASE_URL="postgresql://postgres:SUA_SENHA@localhost:5432/mesadejogos?schema=public"

# Better Auth
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# URL pública do site (em produção: https://mesadejogos.com)
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth (console.cloud.google.com > APIs e serviços > Credenciais)
# URI de redirecionamento autorizado: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Discord OAuth (discord.com/developers/applications > OAuth2)
# Redirect: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

// Tabelas do Better Auth (login com Google). Depois de mudar: bun run db:migrate
generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  // perfil público em /perfil/<username> (minúsculo, único)
  username        String?   @unique
  displayUsername String?
  // false: só o próprio jogador vê o perfil completo
  profilePublic   Boolean   @default(true)
  // última vez com o site aberto (aviso a cada minuto); amigos veem quem está online
  lastSeenAt      DateTime?
  // user | admin. Admin vê /admin; promover com: bun run admin <email>
  role            String    @default("user")
  // fichas: saldo (soma de chip_transaction) e sequência do login diário (ver lib/chips-rules.ts)
  chips           Int       @default(0)
  loginStreak     Int       @default(0)
  lastLoginDay    String? // AAAA-MM-DD (horário de Brasília)
  // loja: o que o jogador está usando (chave em lib/shop/catalog.ts). null = ficha vermelha / baralho clássico / feltro verde
  equippedFrame   String?
  equippedDeck    String?
  equippedTable   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  results       GameResult[]
  achievements  Achievement[]
  friendsSent     Friendship[] @relation("FriendRequester")
  friendsReceived Friendship[] @relation("FriendAddressee")
  invitesSent     GameInvite[] @relation("InviteFrom")
  invitesReceived GameInvite[] @relation("InviteTo")
  chipTransactions ChipTransaction[]
  items            UserItem[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// Uma linha por jogador por partida terminada. Recordes, sequências e rivalidade saem daqui.
model GameResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      String // ver lib/stats/games.ts
  mode      String // solo | ai | online
  outcome   String // win | loss | draw
  // colocação (1 = primeiro) nos jogos com mais de dois lados (Stop)
  placement Int?
  // mesma partida para todos que jogaram: liga os jogadores na rivalidade
  matchId   String?
  // números da partida (tempo, jogadas, pontos…) de cada jogo
  data      Json     @default("{}")
  // dia do desafio diário (AAAA-MM-DD) quando a partida foi um; conta uma vez por jogador
  daily     String?
  createdAt DateTime @default(now())

  @@unique([userId, game, daily])
  @@index([userId, game, createdAt])
  @@index([matchId])
  @@map("game_result")
}

// Desafio diário: a mesma partida para todos num dia (horário de Brasília). Fica guardado para rejogar depois.
model DailyChallenge {
  game      String // ver lib/daily/challenge.ts
  day       String // AAAA-MM-DD
  // sudoku: { difficulty, seed, puzzle, solution }; paciencia-spider: { suits, seed, deck }
  data      Json
  createdAt DateTime @default(now())

  @@id([game, day])
  @@map("daily_challenge")
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String // ver lib/stats/achievements.ts
  unlockedAt DateTime @default(now())

  @@unique([userId, code])
  @@index([userId, unlockedAt])
  @@map("achievement")
}

// Convite de amizade: requester pediu, addressee aceita (vira "accepted") ou recusa (linha apagada).
// Uma linha por par: quem tenta convidar quem já o convidou aceita o convite.
model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  requester   User      @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User      @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String // pending | accepted
  createdAt   DateTime  @default(now())
  acceptedAt  DateTime?

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("friendship")
}

// Convite de um amigo para a sala de um jogo online. Vale por alguns minutos (lib/invites-rules.ts);
// some quando o convidado entra ou dispensa. Convidar de novo para a mesma sala renova o horário.
model GameInvite {
  id        String   @id @default(cuid())
  fromId    String
  from      User     @relation("InviteFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User     @relation("InviteTo", fields: [toId], references: [id], onDelete: Cascade)
  game      String // GameId (ver lib/stats/games.ts)
  code      String // código da sala
  createdAt DateTime @default(now())

  @@unique([fromId, toId, code])
  @@index([toId, createdAt])
  @@map("game_invite")
}

// Cada ficha ganha (ou gasta) é uma linha; user.chips é a soma. Único por motivo + referência:
// a mesma conquista, o mesmo dia de login ou as boas-vindas nunca pagam duas vezes.
model ChipTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta     Int
  reason    String // welcome | achievement | login | purchase | admin
  ref       String // achievement: código; login: AAAA-MM-DD; welcome: "welcome"; purchase: item:hora; admin: id único
  // admin: quem deu/tirou e por quê
  byId      String?
  note      String?
  createdAt DateTime @default(now())

  @@unique([userId, reason, ref])
  @@index([userId, createdAt])
  @@map("chip_transaction")
}

// Item da loja que o jogador tem (ou teve). Uma linha por jogador + item: comprar de novo ou ganhar de novo
// depois de tirado reaproveita a linha. removedAt preenchido = o admin tirou (fica no histórico).
model UserItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String // ver lib/shop/catalog.ts ("frame:madeira", "deck:noite")
  source      String // purchase | admin
  // fichas pagas (compra) ou null (presente do admin)
  price       Int?
  // admin que deu (source admin)
  grantedById String?
  acquiredAt  DateTime  @default(now())
  removedAt   DateTime?
  removedById String?

  @@unique([userId, itemId])
  @@index([userId, acquiredAt])
  @@map("user_item")
}

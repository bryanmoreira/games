{
  "name": "@truco/web",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev -p 3000",
    "build": "prisma generate && next build && cp -R .next/static .next/standalone/apps/web/.next/static && cp -R public .next/standalone/apps/web/public",
    "start": "bun .next/standalone/apps/web/server.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@truco/batalha-naval": "workspace:*",
    "@truco/codenames": "workspace:*",
    "@truco/connect4": "workspace:*",
    "@truco/game": "workspace:*",
    "@truco/otrio": "workspace:*",
    "@truco/spider": "workspace:*",
    "@truco/stop": "workspace:*",
    "@truco/sudoku": "workspace:*",
    "better-auth": "^1.7.7",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5"
  }
}

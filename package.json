{
  "name": "mesa-de-jogos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter './apps/*' dev",
    "build": "bun --filter './apps/*' build",
    "start": "bun --filter './apps/*' start",
    "cards": "bun run scripts/fetch-cards.ts",
    "test": "bun test packages apps/web/test apps/server/test"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "5"
  }
}
